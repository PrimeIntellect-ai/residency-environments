# syntax=docker/dockerfile:1

FROM nvidia/cuda:12.8.1-devel-ubuntu22.04@sha256:a99a1860ba8e2916e5c3e73b72ec4c4301653a84586e05bfc9a2aa2d58027e97

ARG UV_VERSION=0.9.10

# CUDA harness image. Triton harnesses use Dockerfile.triton.
RUN apt-get -o Acquire::Retries=5 update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl python3 python3-pip python-is-python3 \
    && rm -rf /var/lib/apt/lists/* \
    && curl --version | head -1

RUN pip3 install --no-cache-dir "uv==${UV_VERSION}"
COPY scripts/pmpp-hard/harness-deps.py /tmp/harness-deps.py
RUN uv sync --script /tmp/harness-deps.py --no-config \
    && UV_OFFLINE=true uv sync --script /tmp/harness-deps.py --no-config \
    && rm /tmp/harness-deps.py

ENV UV_OFFLINE=true UV_PYTHON_DOWNLOADS=never
