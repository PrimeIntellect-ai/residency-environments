# syntax=docker/dockerfile:1

FROM ubuntu:22.04 AS cutlass-source

ARG CUTLASS_REF=e6233cbac5d7c7a865c19c91cd684ceece19513c

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && git init /src/cutlass \
    && git -C /src/cutlass remote add origin https://github.com/NVIDIA/cutlass.git \
    && git -C /src/cutlass fetch --depth 1 origin "${CUTLASS_REF}" \
    && git -C /src/cutlass checkout --detach FETCH_HEAD

FROM nvidia/cuda:12.8.1-devel-ubuntu22.04@sha256:a99a1860ba8e2916e5c3e73b72ec4c4301653a84586e05bfc9a2aa2d58027e97

ARG UV_VERSION=0.9.10

RUN apt-get update -qq \
    && apt-get install -y -qq \
        ca-certificates curl python3 python3-pip python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=cutlass-source /src/cutlass/include /opt/cutlass/include
COPY --from=cutlass-source /src/cutlass/tools/util/include /opt/cutlass/tools/util/include

RUN pip3 install --no-cache-dir "uv==${UV_VERSION}"
COPY scripts/pmpp-hard/harness-deps.py /tmp/harness-deps.py
RUN uv sync --script /tmp/harness-deps.py --no-config \
    && UV_OFFLINE=true uv sync --script /tmp/harness-deps.py --no-config \
    && rm /tmp/harness-deps.py

ENV CPLUS_INCLUDE_PATH=/opt/cutlass/include:/opt/cutlass/tools/util/include \
    UV_OFFLINE=true \
    UV_PYTHON_DOWNLOADS=never
